# Telegram Bot API Token (Required)
TALLY_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated list of allowed group/chat IDs (e.g. -1001234567890)
# Leave empty to allow all chats where the bot is added
ALLOWED_CHAT_IDS=-1001234567890

# Comma-separated list of owner user IDs
OWNER_IDS=123456789

# If true, only messages sent by OWNER_IDS are tallied into the ledger
COUNT_ONLY_OWNER=true

# Require amount messages to be a REPLY to a valid reference/phone message
REQUIRE_REPLY=true

# Strict allowed denominations (5K, 10K, 15K, 20K, 25K)
STRICT_DENOMINATIONS=true
ALLOWED_DENOMINATIONS=5000,10000,15000,20000,25000
MIN_ALLOWED_AMOUNT=5000
MAX_ALLOWED_AMOUNT=25000

# Minimum value for a bare digit number without K/M suffix to be counted as money
MIN_BARE_AMOUNT=1000

# Max digit length for bare numbers (longer digits are treated as phone/account numbers)
MAX_BARE_DIGITS=6

# Optional currency suffix displayed in reports (e.g., MMK, Ks)
CURRENCY_SUFFIX=

# Permission for commands inside group chats: "anyone" or "owner"
GROUP_COMMANDS=anyone